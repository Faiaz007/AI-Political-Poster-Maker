# --- API ---
# The API origin, with NO trailing path.
#
# Every request path in src/lib/api.ts already starts with /api, so this value
# must be a bare origin. Setting it to ".../api" produces doubled paths such as
# /api/api/auth/register and every request 404s.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time, so
# changing this requires a rebuild/redeploy, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:5000
