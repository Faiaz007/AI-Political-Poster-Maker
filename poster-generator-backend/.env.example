# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/poster_generator

# --- Auth ---
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace_me_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# --- Gemini AI ---
GEMINI_API_KEY=replace_me
# Must be a real model ID. `gemini-3.5-flash-lite` does not exist and every
# AI call fails with a 404 from the API. The default below matches env.ts.
GEMINI_MODEL=gemini-2.5-flash

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# --- Frontend (CORS origin) ---
FRONTEND_URL=http://localhost:3000

# --- Storage driver: cloudinary | local | datauri ---
# "local" writes files to ./uploads and serves them from /uploads (useful for
# local development without a Cloudinary account).
#
# "datauri" inlines each asset into the referencing document as a `data:` URI, so
# nothing is read from disk. Best for a small fixed set of assets (seeded
# template artwork) on hosts that wipe the filesystem; the bytes live in
# MongoDB, so it is not a good fit for unbounded user uploads.
#
# WARNING: Render/Railway/Fly wipe the container filesystem on every deploy, so
# "local" loses every uploaded photo and rendered poster. Use "cloudinary" (or
# "datauri" for template artwork only) in production, or attach a persistent
# disk and point LOCAL_STORAGE_DIR at it.
STORAGE_DRIVER=local

# Absolute origin Chromium uses to fetch locally-stored assets. MUST be the
# public origin of this service in production, or renders silently fail to
# load uploaded photos. Irrelevant when every asset is a data: URI.
PUBLIC_BASE_URL=http://localhost:5000
